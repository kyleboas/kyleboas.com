{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infiniteflight-inbounds",
  "main": "src/infiniteflight-worker.js",
  "compatibility_date": "2025-03-01",
  "routes": ["kyleboas.com/api/infiniteflight/*"],
  "durable_objects": {
    "bindings": [
      {
        "name": "INFINITEFLIGHT_COORDINATOR",
        "class_name": "InfiniteFlightUpstreamCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InfiniteFlightUpstreamCoordinator"]
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://kyleboas.com",
    "INFINITEFLIGHT_SESSION_NAME": "Expert Server",
    "INFINITEFLIGHT_UPSTREAM_REQUESTS_PER_MINUTE": "30"
  }
}
